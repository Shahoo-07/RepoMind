# LLM / Embeddings (Ollama)
OPENAI_API_KEY=
LLM_MODEL=llama3.2:latest
EMBEDDING_MODEL=embeddinggemma:latest
EMBEDDING_DIM=768
OLLAMA_HOST=http://127.0.0.1:11434

# Vector store
LANCEDB_URI=./data/lancedb
LANCEDB_TABLE=code_chunks

# Retrieval
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5

# App
API_HOST=0.0.0.0
API_PORT=8000
